    <!--
      工地工人（动态障碍）：
      - 继续用 walk.dae 走路动画
      - Actor 内嵌黄色安全帽 + 橙色马甲，看起来像施工人员
      - Actor 不受物理碰撞，但 GPU LiDAR/相机可感知
      - 若安全帽位置偏高/偏低，只改 hardhat link 的 z
    -->
    <actor name="worker_x">
      <skin>
        <filename>file:///usr/share/gazebo-11/media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>file:///usr/share/gazebo-11/media/models/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>

      <!-- 橙色马甲（胸口） -->
      <link name="vest">
        <pose>0.03 0 0.12 0 0 0</pose>
        <visual name="vest_visual">
          <geometry>
            <box>
              <size>0.22 0.34 0.36</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.45 0.05 1</ambient>
            <diffuse>1.0 0.50 0.08 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- 单顶黄色安全帽：帽盔 + 帽檐，避免厚球壳 mesh 看起来像两顶 -->
      <link name="hardhat">
        <!-- 相对人体稍微前移，避免前额穿出帽檐 -->
        <pose>0.07 0 0.55 0 0 0</pose>
        <visual name="hardhat_dome">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.11</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.95 0.80 0.10 1</ambient>
            <diffuse>1.0 0.85 0.12 1</diffuse>
            <specular>0.35 0.35 0.25 1</specular>
          </material>
        </visual>
        <visual name="hardhat_brim">
          <pose>0.02 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.80 0.10 1</ambient>
            <diffuse>1.0 0.85 0.12 1</diffuse>
            <specular>0.35 0.35 0.25 1</specular>
          </material>
        </visual>
      </link>

      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0</time>
            <pose>-3.0 1.5 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>3.0 1.5 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>7</time>
            <pose>3.0 1.5 1.0 0 0 3.1416</pose>
          </waypoint>
          <waypoint>
            <time>13</time>
            <pose>-3.0 1.5 1.0 0 0 3.1416</pose>
          </waypoint>
          <waypoint>
            <time>14</time>
            <pose>-3.0 1.5 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="worker_y">
      <skin>
