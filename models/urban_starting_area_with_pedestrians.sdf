      <link name="hardhat">
        <!-- 相对人体稍微前移，避免前额穿出帽檐 -->
        <pose>0.07 0 0.55 0 0 0</pose>
        <visual name="hardhat_dome">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.11</radius>
