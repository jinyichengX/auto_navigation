    <!-- 起飞点实体承载板：局部地面是薄网格（z 0~0.134、含朝向错误三角形），
         飞行器降落会穿进网格被卡住。这里放一块实心 box 承载板，顶面与网格最高点齐平，
         保证起飞点一定是实体接触面。 -->
    <model name="spawn_platform">
      <static>true</static>
      <pose>-40.877358 64.956595 -0.066 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 4.0 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 4.0 0.40</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
