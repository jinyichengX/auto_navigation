      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0</time>
            <pose>1.5 -3.0 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>1.5 3.0 1.0 0 0 1.5708</pose>
