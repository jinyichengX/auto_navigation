<?xml version="1.0" encoding="UTF-8"?>
<!--
  Urban Starting Area + 动态行人 + 北侧井下（DARPA SubT）
  - 大厅北墙开约 4m 门洞，外接 simple_tunnel_03
  - 使用 Gazebo Harmonic Actor，不依赖 hunav_gazebo_wrapper
  - 用法：复制到 PX4 worlds 后，用 PX4_GZ_WORLD=urban_starting_area_with_pedestrians 启动
-->
<sdf version="1.9">
  <world name="urban_starting_area_with_pedestrians">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>true</grid>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.65 0.72 0.82 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 80 0 -0.5 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.2</intensity>
      <direction>0.25 0.35 -1.0</direction>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <attenuation>
        <range>4000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <light name="fill" type="directional">
      <pose>0 0 40 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.45</intensity>
      <direction>-0.3 -0.2 -1.0</direction>
      <diffuse>0.75 0.80 0.90 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>4000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <include>
      <static>true</static>
      <name>urban_starting_area</name>
      <!-- Hall center ~ (4.10, 24.75, 7.512); shift so hall center/floor sit at world origin -->
      <pose>-4.097744 -24.7535095 -7.512 0 0 0</pose>
      <uri>file:///home/jinyicheng/auto_navigation/models/UrbanStartingAreaNorthPortal/model.sdf</uri>
    </include>

    <!--
      仓库（Depot）原尺寸：南墙/西南角横放
      - yaw=0，约 30.6 x 15.6 m
      - 相对大厅墙体内缩约 2 m，避免穿出大厅
      - 覆盖大约 x[-21.7, 8.9], y[-18.9, -3.3]，避开原点行人区
      - 若仍穿模：优先减小 |x|/|y| 往大厅内侧挪
    -->
    <include>
      <static>true</static>
      <name>warehouse</name>
      <pose>-3 2 -0.09 0 0 1.5707963</pose>
      <uri>file:///home/jinyicheng/auto_navigation/models/warehouse/model.sdf</uri>
    </include>

    <!--
      北侧井下：DARPA SubT simple_tunnel_03（Harmonic 适配）
      - 原世界入口在 (10,0)，绕 Z +90° 后接到大厅北墙门洞
      - 真实门洞中心约 x=-0.88，北墙 y≈14.91
      - 已切开北侧外延 ConcreteTiles + Floor 通道（y≈15.75 / 20.75）
      - 当前入口约 (-0.88, 14.96, 0）；PX4 worlds 已同步此文件
      - DARPA 隧道模型已本地化到 models/darpa_fuel，启动不再依赖 Fuel 下载
    -->

    <!-- 门洞补墙：北墙开洞比隧道口更宽，封两侧缝 -->
    <model name="mine_portal_fill_west">
      <static>true</static>
      <pose>-5.687358 14.956596 1.500000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.4 3.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.4 3.2</size></box></geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="mine_portal_fill_east">
      <static>true</static>
      <pose>3.932642 14.956596 1.500000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.4 3.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.4 3.2</size></box></geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="mine_portal_lintel">
      <static>true</static>
      <pose>-0.877358 14.956596 3.550000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.4 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.4 0.9</size></box></geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      东门外出：出东门 -> 左拐北向长廊(x≈17.9~22.9) -> 尽头再左拐西行。
      从东外墙 x≈22.90 再向西 10 m 处封堵整条西向长廊（y∈[15.75,20.75], z∈[0,5]）。
      视觉盒与碰撞盒尺寸/位姿完全一致。
    -->
    <model name="east_corridor_blocker">
      <static>true</static>
      <pose>12.902256 18.250000 2.500000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 5.00 5.00</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 5.00 5.00</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.30 0.28 1</ambient>
            <diffuse>0.42 0.39 0.35 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

