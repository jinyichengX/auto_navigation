<?xml version="1.0"?>
<!-- 小木箱 0.50 m 立方，原点在几何中心（放置时 z = 地面 + 0.25） -->
<sdf version="1.9">
  <model name="wooden_crate_50">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.50 0.50 0.50</size>
          </box>
        </geometry>
      </collision>
      <visual name="body">
        <geometry>
          <box>
            <size>0.48 0.48 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.42 0.30 0.17 1</ambient>
          <diffuse>0.58 0.42 0.25 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="frame_top">
        <pose>0 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.52 0.52 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.26 0.18 0.11 1</ambient>
          <diffuse>0.38 0.27 0.16 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="frame_bottom">
        <pose>0 0 -0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.52 0.52 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.26 0.18 0.11 1</ambient>
          <diffuse>0.38 0.27 0.16 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
