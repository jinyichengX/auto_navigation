整个项目的目标是无人机自己探索完整个地图（不限于下面的地图，而是任意的不规则地图），依次启动命令是
PX4_GZ_NO_FOLLOW=1 PX4_GZ_WORLD=urban_starting_area_with_pedestrians PX4_GZ_MODEL_POSE="-40.877358,64.956595,1.5" make px4_sitl gz_x500_livox_mid360
MicroXRCEAgent udp4 -p 8888
ros2 run nav3 fastlio2_input_bridge
ros2 launch fast_lio mapping.launch.py rviz:=false
ros2 run nav3 fastlio_odom_bridge
ros2 launch px4_control octomap_mapping.launch.py
ros2 run nav3 offboard_control
ros2 run nav3 nbvplanner_explorer
